# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Build artifacts
build/
pipeline.zip
*.egg-info/

# TypeScript incremental build cache
gui/*.tsbuildinfo

# Safety net: never commit anything under a .secrets dir. The pipeline writes
# no secrets to disk (Cognito emails the one-time temporary password).
.secrets/

# GUI env files written by deploy (contain API/auth config)
gui/.env.local
gui/.env.production.local

# Node / GUI
gui/node_modules/
gui/dist/

# Local offline-run scratch (generate_synthetic.py / run_local.py defaults).
# The deployed pipeline uses S3, not these local dirs.
data/

# OS
.DS_Store

# Security scanner output (generated per scan)
.protoshield/

# Scanner state and reports (local only)
.holmes/
holmes-report-*.json
.protoshield/
